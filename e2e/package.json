{
  "name": "sage3-e2e",
  "version": "0.1.0",
  "private": true,
  "description": "Playwright browser E2E tests for SAGE3 (credentials store + SSH terminal). Runs against a deployed instance (default: staging).",
  "scripts": {
    "test": "playwright test",
    "test:headed": "playwright test --headed",
    "report": "playwright show-report",
    "ssh-target:up": "bash scripts/ssh-target.sh up",
    "ssh-target:down": "bash scripts/ssh-target.sh down"
  },
  "devDependencies": {
    "@playwright/test": "^1.61.1"
  }
}
